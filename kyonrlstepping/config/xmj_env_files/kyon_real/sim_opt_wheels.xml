<?xml version="1.0" ?>
<mujoco>
    <!-- <compiler discardvisual="false" strippath="false" angle="radian" autolimits="true" balanceinertia="true" fusestatic="true" boundmass="0"/> -->

    <option cone="elliptic" impratio="100" timestep="0.0005"/>
    <!-- Simulation settings -->
    <size njmax="1000" nconmax="200"/>

    <contact>
        <exclude name="upper_leg_1_exclude" body1="pelvis" body2="hip_pitch_1_link"/>
        <exclude name="upper_leg_2_exclude" body1="pelvis" body2="hip_pitch_2_link"/>
        <exclude name="upper_leg_3_exclude" body1="pelvis" body2="hip_pitch_3_link"/>
        <exclude name="upper_leg_4_exclude" body1="pelvis" body2="hip_pitch_4_link"/>
        <exclude name="hip_roll_1_exclude" body1="pelvis" body2="hip_roll_1_link"/>
        <exclude name="hip_roll_2_exclude" body1="pelvis" body2="hip_roll_2_link"/>
        <exclude name="hip_roll_3_exclude" body1="pelvis" body2="hip_roll_3_link"/>
        <exclude name="hip_roll_4_exclude" body1="pelvis" body2="hip_roll_4_link"/>

        <exclude name="knee_pitch1_exclude" body1="knee_pitch_1_link" body2="hip_pitch_1_link"/>
        <exclude name="knee_pitch2_exclude" body1="knee_pitch_2_link" body2="hip_pitch_2_link"/>
        <exclude name="knee_pitch3_exclude" body1="knee_pitch_3_link" body2="hip_pitch_3_link"/>
        <exclude name="knee_pitch4_exclude" body1="knee_pitch_4_link" body2="hip_pitch_4_link"/>
        
        <!-- ankle yaw (wheel mode) collisions-->
        <exclude name="ankle_yaw1_exclude" body1="knee_pitch_1_link" body2="ankle_yaw_1_link"/>
        <exclude name="ankle_yaw2_exclude" body1="knee_pitch_2_link" body2="ankle_yaw_2_link"/>
        <exclude name="ankle_yaw3_exclude" body1="knee_pitch_3_link" body2="ankle_yaw_3_link"/>
        <exclude name="ankle_yaw4_exclude" body1="knee_pitch_4_link" body2="ankle_yaw_4_link"/>

        <exclude name="wheel_shin1_exclude" body1="ankle_yaw_1_link" body2="wheel_1"/>
        <exclude name="wheel_shin2_exclude" body1="ankle_yaw_2_link" body2="wheel_2"/>
        <exclude name="wheel_shin3_exclude" body1="ankle_yaw_3_link" body2="wheel_3"/>
        <exclude name="wheel_shin4_exclude" body1="ankle_yaw_4_link" body2="wheel_4"/>
        <!--exclude name="hip_pitch_1_exclude" body1="pelvis" body2="hip_pitch_motor_1"/>
        <exclude name="hip_pitch_2_exclude" body1="pelvis" body2="hip_pitch_motor_2"/>
        <exclude name="hip_pitch_3_exclude" body1="pelvis" body2="hip_pitch_motor_3"/>
        <exclude name="hip_pitch_4_exclude" body1="pelvis" body2="hip_pitch_motor_4"/-->
    </contact>

    <sensor>
        <accelerometer name="imu_link_acc" site="imu_link"/>
        <gyro name="imu_link_gyro" site="imu_link"/>
    </sensor>
    
    <visual>
        <quality shadowsize="2048" />
    </visual>

    <!-- Sensor settings -->
    <!-- <sensor>
        <accelerometer name="accel" body="example_body"/>
        <gyroscope name="gyro" body="example_body"/>
    </sensor> -->

    <!-- Contact parameters -->
    <!-- <contact>
        <pair body1="example_body" body2="ground" friction="0.5"/>
    </contact> -->
</mujoco>
